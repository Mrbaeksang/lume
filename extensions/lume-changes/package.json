{
  "name": "lume-changes",
  "displayName": "Lume — AI Changes",
  "description": "See what an AI agent changed in your workspace, and review it before you keep it.",
  "version": "0.0.1",
  "publisher": "lume",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lume",
          "title": "Lume",
          "icon": "resources/lume-icon.svg"
        }
      ]
    },
    "views": {
      "lume": [
        {
          "id": "lume.changes",
          "name": "AI Changes"
        },
        {
          "id": "lume.checkpoints",
          "name": "Checkpoints"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lume.changes",
        "contents": "No AI changes yet.\nRun your agent (Claude Code, Codex, …) — what it edits will appear here to review."
      },
      {
        "view": "lume.checkpoints",
        "contents": "No checkpoints yet.\nSnapshot your workspace so you can roll back to it later.\n[Create checkpoint](command:lume.checkpoint.create)"
      }
    ],
    "commands": [
      {
        "command": "lume.refresh",
        "title": "Lume: Refresh AI Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "lume.accept",
        "title": "Lume: Keep (Accept) Change",
        "icon": "$(check)"
      },
      {
        "command": "lume.undo",
        "title": "Lume: Undo Change",
        "icon": "$(discard)"
      },
      {
        "command": "lume.acceptAll",
        "title": "Lume: Keep All",
        "icon": "$(check-all)"
      },
      {
        "command": "lume.undoAll",
        "title": "Lume: Undo All",
        "icon": "$(discard)"
      },
      {
        "command": "lume.checkpoint.create",
        "title": "Lume: Create Checkpoint",
        "icon": "$(add)"
      },
      {
        "command": "lume.checkpoint.restore",
        "title": "Lume: Restore Checkpoint",
        "icon": "$(history)"
      },
      {
        "command": "lume.checkpoint.delete",
        "title": "Lume: Delete Checkpoint",
        "icon": "$(trash)"
      },
      {
        "command": "lume.preview.open",
        "title": "Lume: Live Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lume.acceptAll",
          "when": "view == lume.changes",
          "group": "navigation@1"
        },
        {
          "command": "lume.undoAll",
          "when": "view == lume.changes",
          "group": "navigation@2"
        },
        {
          "command": "lume.refresh",
          "when": "view == lume.changes",
          "group": "navigation@3"
        },
        {
          "command": "lume.checkpoint.create",
          "when": "view == lume.checkpoints",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "lume.accept",
          "when": "view == lume.changes",
          "group": "inline@1"
        },
        {
          "command": "lume.undo",
          "when": "view == lume.changes",
          "group": "inline@2"
        },
        {
          "command": "lume.checkpoint.restore",
          "when": "view == lume.checkpoints",
          "group": "inline@1"
        },
        {
          "command": "lume.checkpoint.delete",
          "when": "view == lume.checkpoints",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "lume.preview.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Lume",
      "properties": {
        "lume.preview.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Default URL for Lume Live Preview (your dev server)."
        },
        "lume.preview.reloadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Reload the Lume Live Preview when you save a file."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
