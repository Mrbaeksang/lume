{
  "name": "lume-changes",
  "displayName": "Lume — AI Changes",
  "description": "See what an AI agent changed in your workspace, and review it before you keep it.",
  "version": "0.0.1",
  "publisher": "lume",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lume",
          "title": "Lume",
          "icon": "resources/lume-icon.svg"
        }
      ]
    },
    "views": {
      "lume": [
        {
          "id": "lume.changes",
          "name": "AI Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lume.changes",
        "contents": "No AI changes yet.\nRun your agent (Claude Code, Codex, …) — what it edits will appear here to review."
      }
    ],
    "commands": [
      {
        "command": "lume.refresh",
        "title": "Lume: Refresh AI Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "lume.accept",
        "title": "Lume: Keep (Accept) Change",
        "icon": "$(check)"
      },
      {
        "command": "lume.undo",
        "title": "Lume: Undo Change",
        "icon": "$(discard)"
      },
      {
        "command": "lume.acceptAll",
        "title": "Lume: Keep All",
        "icon": "$(check-all)"
      },
      {
        "command": "lume.undoAll",
        "title": "Lume: Undo All",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lume.acceptAll",
          "when": "view == lume.changes",
          "group": "navigation@1"
        },
        {
          "command": "lume.undoAll",
          "when": "view == lume.changes",
          "group": "navigation@2"
        },
        {
          "command": "lume.refresh",
          "when": "view == lume.changes",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "lume.accept",
          "when": "view == lume.changes",
          "group": "inline@1"
        },
        {
          "command": "lume.undo",
          "when": "view == lume.changes",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
